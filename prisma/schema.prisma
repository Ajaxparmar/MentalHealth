generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


// =========================
// USER
// =========================

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  name      String
  email     String   @unique
  password  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers       Answer[]
  gameScore     GameScore?
  mentalProfile MentalHealthProfile?
  aiProfile     AIProfile?
}


// =========================
// QUESTIONS
// =========================

model Question {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  question  String

  // Four objective options
  optionA   String
  optionB   String
  optionC   String
  optionD   String

  // Correct / scoring option
  correctOption String

  category  String?
  order     Int

  createdAt DateTime @default(now())

  answers Answer[]
}


// =========================
// USER ANSWERS
// =========================

model Answer {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId

  userId     String   @db.ObjectId
  questionId String   @db.ObjectId

  // A, B, C or D
  selectedOption String

  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@index([userId])
  @@index([questionId])
}


// =========================
// GAME SCORES
// =========================

model GameScore {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  userId    String   @unique @db.ObjectId

  game1Score Float
  game2Score Float

  totalScore Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}


// =========================
// MENTAL HEALTH RESULT
// =========================

model MentalHealthProfile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  userId    String   @unique @db.ObjectId

  stressScore    Float?
  anxietyScore   Float?
  moodScore      Float?
  wellbeingScore Float?
  overallScore   Float?

  status String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}


// =========================
// AI PROMPT + PERSONA
// =========================

model AIProfile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  userId    String   @unique @db.ObjectId

  prompt    String
  persona   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}